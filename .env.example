# ============================================================
# RIDER LOCATION TRACKING — Environment Variables
# Copy to .env and update with your actual values
# ============================================================

# MongoDB connection string
MONGO_URI=mongodb://localhost:27017/rider
MONGODB_URL=mongodb://localhost:27017/rider
MONGO_DB=rider

# Kafka brokers (comma-separated for multiple brokers)
KAFKA_BROKERS=localhost:9092

# Kafka topic for location updates
KAFKA_TOPIC=location-updates

# Application base URL (for OAuth callbacks and frontend socket)
APP_BASE_URL=http://localhost:3300

# Express session secret (CHANGE IN PRODUCTION!)
SESSION_SECRET=your-secret-key-here-change-in-production

# Location event retention time in seconds (default: 30 days = 2592000)
# Set to lower for testing (e.g., 60 for 1 minute)
LOCATION_EVENT_TTL_SECONDS=2592000

# Google OAuth credentials (required for login)
GOOGLE_CLIENT_ID=your-google-client-id-here
GOOGLE_CLIENT_SECRET=your-google-client-secret-here
GOOGLE_CALLBACK_URL=http://localhost:3300/auth/google/callback

# Kafka authentication method (plain, sasl, or mtls)
# If mtls: place certs in api/kafka/ (ca.pem, service.cert, service.key)
KAFKA_AUTH_METHOD=plain

# Server port (optional, defaults to 3300)
PORT=3300

# Node environment
NODE_ENV=development

# ============================================================
# Notes:
# - MONGO_URI or MONGODB_URL can be used interchangeably
# - For production Kafka (Aiven), use KAFKA_AUTH_METHOD=sasl or mtls
# - Google OAuth: get credentials from console.cloud.google.com
# - TTL index on LocationEvent.timestamp for data retention
# ============================================================

